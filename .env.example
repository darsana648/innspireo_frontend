# ---------------------------------------------------------------------------
# Innspireo — frontend environment
# Copy to .env.local and fill in. Nothing here is required to run the site:
# with no values set, job data loads from the live public API and the
# auth/enquiry screens show an honest "not connected yet" state.
# ---------------------------------------------------------------------------

# Base URL of the API serving job data. Defaults to the production host.
NEXT_PUBLIC_API_BASE=https://jobs.innspireo.com

# Account features (sign in, apply, save a role, profile) are OFF until this
# is "true". Turn it on only when NEXT_PUBLIC_API_BASE points at a backend
# that provides all of the following — the frontend client is already written
# against them, in src/lib/auth.ts and src/lib/candidate.ts:
#
#   GET  /api/csrf-cookie            (or /sanctum/csrf-cookie) sets XSRF-TOKEN
#   POST /api/register               -> { user }
#   POST /api/login  /api/logout
#   GET  /api/user                   -> 401 when signed out
#   POST /api/email/verify  /api/email/resend
#   POST /api/forgot-password  /api/reset-password
#   GET/PATCH /api/candidate/profile
#   POST/DELETE /api/candidate/cv
#   POST /api/applications
#   GET  /api/candidate/applications
#   GET/POST/DELETE /api/candidate/saved-jobs
#
# plus CORS allowing this origin with credentials, and a session cookie on a
# domain both this site and the API share.
#
# The live Laravel backend at jobs.innspireo.com has NONE of these — its
# /login and /register are Blade pages that take a session POST, not JSON —
# so leave this false while pointing at it.
NEXT_PUBLIC_API_AUTH_ENABLED=false

# Where employer hiring briefs and contact messages are delivered. Any JSON
# POST endpoint works: an API route the backend team adds, or a Zapier / Make
# / n8n catch hook. Until this is set, the forms fall back to a prefilled
# email + WhatsApp handoff instead of silently failing.
# ENQUIRY_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Splitting the corporate site from the job board
#
# The plan is: corporate pages (/, /about, /services, /hire-with-us, /contact,
# /blogs, /faqs) on the apex domain, job board (/jobs, /login, /register,
# /dashboard, /applications, /saved-jobs) on jobs.innspireo.com.
#
# While BOTH ship from this one app, leave both of these unset — every link
# stays a same-origin path and nothing changes.
#
# When you split them, deploy this app twice:
#
#   Corporate deployment (innspireo.com)
#     NEXT_PUBLIC_SITE_URL=https://innspireo.com
#     NEXT_PUBLIC_JOBS_BASE_URL=https://jobs.innspireo.com
#
#   Job board deployment (jobs.innspireo.com)
#     NEXT_PUBLIC_SITE_URL=https://jobs.innspireo.com
#     (leave NEXT_PUBLIC_JOBS_BASE_URL unset so its own job links stay local)
#
# NEXT_PUBLIC_SITE_URL sets canonical URLs, OpenGraph URLs and the sitemap.
# NEXT_PUBLIC_JOBS_BASE_URL makes every job-board link absolute (jobsUrl()).
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=
# NEXT_PUBLIC_JOBS_BASE_URL=
